# Copy this file to .env only for local reference. Do not commit .env.
# Use the Supabase connection string from Project Settings > Database.
# Prefer the transaction/session pooler for deployed applications.
SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=replace-with-your-database-password
